# Locally uploaded avatars (served from a Docker volume in containers; not source)
Sosyolobi Backend/Sosyolobi.Api/wwwroot/avatars/*
!Sosyolobi Backend/Sosyolobi.Api/wwwroot/avatars/.gitkeep

# Locally cached category images (downloaded from Pexels, served from a Docker volume; not source)
Sosyolobi Backend/Sosyolobi.Api/wwwroot/categories/*
!Sosyolobi Backend/Sosyolobi.Api/wwwroot/categories/.gitkeep

